# ===== F21DV Group 4 — .gitignore =====

# ---------- Documentation (exclude all .md EXCEPT README.md) ----------
*.md
!README.md

# ---------- Python / Anaconda ----------
__pycache__/
*.py[cod]
*.egg-info/
.conda/
anaconda_projects/
*.ipynb_checkpoints/
.ipynb_checkpoints/

# ---------- EDA outputs (not needed in submission) ----------
eda_plots/
eda_results.html
EDA_notebook.html
run_eda.py

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- Misc ----------
*.log
*.tmp
*.bak
node_modules/

# Local Netlify folder
.netlify
